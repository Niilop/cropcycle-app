# Optional. By default the app calls the API on port 8000 of the host that served the app
# (localhost in the browser, 10.0.2.2 in the Android emulator, your PC's address in Expo Go).
# Copy to .env.local and set this to use another API, e.g. a hosted one.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
