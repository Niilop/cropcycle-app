APP_NAME=CropCycle
DEBUG=false

# Point at a dedicated database in your local devstack.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cropcycle

# Generate with: uv run --package backend python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Mobile sign-in persists on the device; 43200 minutes = 30 days.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Empty disables cross-origin browser access. Accepts comma-separated URLs or a JSON array.
CORS_ORIGINS=
